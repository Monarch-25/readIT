{
  "manifest_version": 3,
  "name": "Novel Reader",
  "version": "0.3.0",
  "description": "Paste any text and have it read aloud. Runs a local MLX Kokoro voice server from the player — no terminal needed — or points at any vLLM-Omni endpoint.",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Novel Reader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}